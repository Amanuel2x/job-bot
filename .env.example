# Copy this to .env and fill in your values
# On Windows: copy .env.example .env

# -----------------------------------------------
# YOUR INFO
# -----------------------------------------------
FULL_NAME=Amanuel Abu
EMAIL=aabu@sfsu.edu
PHONE=(669) 292-8473
LINKEDIN=https://www.linkedin.com/in/amanuelabu
LOCATION=San Francisco, CA

# Path to your resume PDF
RESUME_PATH=./resume.pdf

# -----------------------------------------------
# TELEGRAM — primary notification channel
# -----------------------------------------------
# 1. Open Telegram, search @BotFather
# 2. Send /newbot, give it any name
# 3. Copy the token it gives you (looks like 7412938475:AAF...)
TELEGRAM_BOT_TOKEN=

# 4. Message your new bot once, then open this URL in your browser:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 5. Copy the "id" number from the "chat" object
TELEGRAM_CHAT_ID=

# -----------------------------------------------
# EMAIL DIGEST — backup notification (optional)
# -----------------------------------------------
# The Gmail account the bot sends FROM (can be the same as notify)
GMAIL_USER=amanuelalexabu@gmail.com

# Gmail App Password (NOT your real password)
# Get one here: myaccount.google.com/apppasswords
# Steps: Google Account → Security → 2-Step Verification → App Passwords
# Name it "Internship Bot", copy the 16-character password
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email to receive the digest (your personal Gmail)
NOTIFY_EMAIL=amanuelalexabu@gmail.com

# -----------------------------------------------
# BOT SETTINGS
# -----------------------------------------------
# Claude API key — for AI cover letters (optional but recommended)
ANTHROPIC_API_KEY=sk-ant-...

# Minimum match score to apply (25 = broad, 40 = focused)
MIN_MATCH_SCORE=25

# Max applications per run — 150 hits ~100-200/day across two runs
APPLY_LIMIT_PER_RUN=150

# Set to true to preview without opening any links
DRY_RUN=false
